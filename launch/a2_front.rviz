Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /DLIO Clouds1
        - /DLIO State1
      Splitter Ratio: 0.55
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Cell Size: 1
      Color: 80; 80; 80
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Ground Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: dlio_map
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: false
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.45
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 180; 180; 180
          Color Transformer: Intensity
          Decay Time: 0.2
          Enabled: false
          Max Intensity: 255
          Min Intensity: 0
          Name: Front Raw Cloud
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 1
          Size (m): 0.01
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /front_lidar/points
          Use Fixed Frame: true
          Use rainbow: true
          Value: false
        - Alpha: 0.20
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: AxisColor
          Decay Time: 8
          Enabled: true
          Max Intensity: 255
          Min Intensity: 0
          Name: Deskewed In Map
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 1
          Size (m): 0.01
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /dlio/odom_node/pointcloud/deskewed_and_transformed_to_map
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Max Intensity: 255
          Min Intensity: 0
          Name: Clean Keyframes
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.025
          Style: Points
          Topic:
            Depth: 10
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /dlio/odom_node/pointcloud/keyframe
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: false
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 60; 45
          Color Transformer: FlatColor
          Decay Time: 30
          Enabled: true
          Max Intensity: 255
          Min Intensity: 0
          Name: Dynamic Removed Points
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 4
          Size (m): 0.05
          Style: Points
          Topic:
            Depth: 10
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /dlio/odom_node/pointcloud/dynamic_removed
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 230; 230; 230
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Max Intensity: 255
          Min Intensity: 0
          Name: Published Map
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.03
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /dlio/map_node/map
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
      Enabled: true
      Name: DLIO Clouds
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 25; 255; 0
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Lines
          Line Width: 0.03
          Name: Map Path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 85; 255
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0.1
          Shaft Length: 0.1
          Topic:
            Depth: 10
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /dlio/odom_node/path_map
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 85; 255; 255
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Billboards
          Line Width: 0.01
          Name: Propagated Map Path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 85; 255
          Pose Style: None
          Radius: 0.01
          Shaft Diameter: 0.1
          Shaft Length: 0.1
          Topic:
            Depth: 10
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /dlio/odom_node/path_map_prop
          Value: true
        - Class: rviz_default_plugins/Odometry
          Enabled: true
          Keep: 100
          Name: Odom
          Position Tolerance: 0.01
          Shape:
            Alpha: 1
            Axes Length: 0.8
            Axes Radius: 0.08
            Color: 255; 25; 0
            Head Length: 0.3
            Head Radius: 0.1
            Shaft Length: 1
            Shaft Radius: 0.05
            Value: Axes
          Topic:
            Depth: 10
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /dlio/odom_node/odom
          Value: true
        - Alpha: 1
          Arrow Length: 0.3
          Axes Length: 0.35
          Axes Radius: 0.1
          Class: rviz_default_plugins/PoseArray
          Color: 255; 180; 0
          Enabled: true
          Head Length: 0.07
          Head Radius: 0.03
          Name: Keyframe Poses
          Shaft Length: 0.23
          Shaft Radius: 0.02
          Shape: Axes
          Topic:
            Depth: 10
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /dlio/odom_node/keyframes
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: Linear Velocity Marker
          Namespaces:
            {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /dlio/odom_node/markers/velocity_linear
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: Angular Velocity Marker
          Namespaces:
            {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /dlio/odom_node/markers/velocity_angular
          Value: true
      Enabled: true
      Name: DLIO State
  Enabled: true
  Global Options:
    Background Color: 0; 0; 0
    Fixed Frame: dlio_map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 35
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.8
      Target Frame: base
      Value: Orbit (rviz)
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1080
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 000000ff00000000fd0000000100000000000001f4000003c2fc0200000001fb000000100044006900730070006c006100790073010000003d000003c2000000c900ffffff00000001000005a0000003c2fc0200000000
  Width: 1600
  X: 50
  Y: 50
